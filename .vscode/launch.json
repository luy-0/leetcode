{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Go: Run Current File",  // 自定义名称
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${file}", 
            "args": [],
            "env": {},
            // "showLog": true,
            // "backend": "lldb"  ,
            // "aslr": false,       // 禁用 ASLR
        },
        {
            "name": "Python: Run Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",  // 关键：自动识别当前文件
            "console": "integratedTerminal",  // 输出到终端
            "justMyCode": false  // 显示第三方库的调试信息（可选）
        }
    ]
}